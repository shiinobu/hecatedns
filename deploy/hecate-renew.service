# UNVERIFIED: written on Windows without a Linux machine. The first certificate is requested by hand with the same
# lego options and "run" instead of "renew"; run it as the hecate user (sudo -u hecate ...), otherwise the key is owned
# by root with mode 0600 and neither this unit nor hecate can read it. This unit only renews.
# /etc/hecate/duckdns.env holds two lines, DUCKDNS_TOKEN=... and LEGO_EMAIL=... (the address Let's Encrypt may use for
# expiry notices; lego cannot renew without one), owned by root with mode 0600; systemd reads it before it drops to the
# hecate user. While this unit runs, the DoT server (same user) could read its environment, so a separate user for
# the renewal is a worthwhile hardening step when the VPS exists.
[Unit]
Description=Renew the HecateDNS TLS certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hecate
Group=hecate
StateDirectory=hecate
EnvironmentFile=/etc/hecate/duckdns.env
ExecStart=/opt/hecate/lego --path /var/lib/hecate/lego --email ${LEGO_EMAIL} --accept-tos --dns duckdns --dns.resolvers 1.1.1.1:53 --dns.propagation-wait 30s --domains example.org --domains *.example.org renew --days 30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077
